# DearDays build-time configuration
# Copy this file to dart_defines.env and fill in your values.
#
# Usage:
#   flutter run --dart-define-from-file=dart_defines.env
#
# For CI/CD, set these as secrets in your GitHub Actions / build pipeline.

# Supabase (required)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# AI backend (Supabase Edge Functions endpoint)
AI_API_URL=https://your-project.supabase.co/functions/v1

# RevenueCat (required for in-app purchases)
REVENUECAT_APPLE_KEY=appl_xxxxx
REVENUECAT_GOOGLE_KEY=goog_xxxxx

# Observability (optional — features disabled when empty)
SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
POSTHOG_API_KEY=phc_xxxxx
POSTHOG_HOST=https://us.i.posthog.com

# Analytics & Crash Reporting (legacy — use Sentry/PostHog instead)
ANALYTICS_URL=
CRASH_REPORT_URL=
