# DearDays Environment Configuration
# Copy this file to .env.dev, .env.staging, or .env.prod and fill in real values.
# NEVER commit actual secrets — only this template is checked in.

# Environment identifier (development | staging | production)
APP_ENV=development

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# AI Backend
AI_API_URL=https://your-ai-backend.com

# RevenueCat
REVENUECAT_APPLE_KEY=your-apple-key
REVENUECAT_GOOGLE_KEY=your-google-key

# Observability
SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
POSTHOG_API_KEY=phc_xxx
POSTHOG_HOST=https://us.i.posthog.com

# CDN
CDN_BASE_URL=https://cdn.your-domain.com

# App Version (auto-set in CI)
APP_VERSION=1.0.0
